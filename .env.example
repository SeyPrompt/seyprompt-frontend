NEXT_PUBLIC_API_URL=https://api.seyprompt.com
# Optional localhost pricing region; ignored in production and when Render visitor geolocation is available.
DEV_PRICING_COUNTRY=IN
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Same server-only value as the backend; never prefix this with NEXT_PUBLIC_.
PRICING_PROXY_SECRET=

# Shared server-only secret (32+ random characters) for signed login IP/geo context.
# Approximate geo uses the Render frontend and a local IP database.
# Optional dedicated key; if empty, login geo uses PRICING_PROXY_SECRET.
LOGIN_METADATA_PROXY_SECRET=
